{
  "name": "Hot Grill Restaurant Website",
  "version": 2,
  "public": false,
  "buildCommand": "echo 'Static site - no build required'",
  "outputDirectory": ".",
  "framework": "static",
  "env": {
    "NODE_ENV": "production"
  },
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
